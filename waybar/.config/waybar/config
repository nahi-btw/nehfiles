{
    "layer": "top",
    "position": "top",
    "height": 26,
    "margin-top": 0,
    "modules-left": ["niri/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "mpris", "memory", "battery", "tray"],
    "niri/workspaces": {
        "format": "{name}"
    },
    "pulseaudio": {
        "format": "VOL {volume}%",
        "format-muted": "VOL muted",
        "on-click": "pavucontrol"
    },
    "mpris": {
        "format": "{status_icon} {artist}",
        "status-icons": {
            "playing": "",
            "paused": "",
            "stopped": ""
        },
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-click-middle": "playerctl previous"
    },
    "memory": {
        "interval": 2,
        "format": "RAM {percentage}%"
    },
    "battery": {
        "interval": 5,
        "states": {
            "low": 15
        },
        "format": "BAT {capacity}%",
        "format-charging": "CHR {capacity}%",
        "format-full": "Battery: FULL",
        "format-low": "Battery: {capacity}% LOW"
    },
    "clock": {
        "interval": 1,
        "format": "| {:%H:%M} |                 ",
        "format-alt": "{:%Y-%m-%d %H:%M:%S}"
    },
    "tray": {
        "spacing": 20
    }
}
